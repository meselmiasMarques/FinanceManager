{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "FinanceManager",
    "Audience": "FinanceManager.Web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "RefreshTokenRememberMeDays": 30
  },
  "Auth": {
    "RefreshCookieName": "fm_refresh",
    "RefreshCookiePath": "/auth",
    "SameSite": "Lax"
  }
}
