@page "/not-found"
@layout MainLayout

<PageTitle>Página não encontrada · FinanceManager</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex flex-column align-center gap-4 mt-16">
    <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Secondary" />
    <MudText Typo="Typo.h5">Página não encontrada</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary">O conteúdo que você procura não existe.</MudText>
    <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary">Voltar ao dashboard</MudButton>
</MudContainer>
