@page "/"
@attribute [Authorize]
@inject DashboardApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Dashboard · FinanceManager</PageTitle>

<div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-4">
    <div>
        <MudText Typo="Typo.h5">Dashboard</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Visão geral das suas finanças</MudText>
    </div>
    <div class="d-flex align-center gap-2">
        <MudSelect T="int" Value="_monthsBack" ValueChanged="OnPeriodChanged" Dense="true"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:170px">
            <MudSelectItem Value="3">Últimos 3 meses</MudSelectItem>
            <MudSelectItem Value="6">Últimos 6 meses</MudSelectItem>
            <MudSelectItem Value="12">Últimos 12 meses</MudSelectItem>
        </MudSelect>
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="Load" title="Atualizar" />
    </div>
</div>

@if (_loading)
{
    <div class="d-flex justify-center pa-10">
        <MudProgressCircular Indeterminate="true" />
    </div>
}
else if (_summary is not null)
{
    <MudGrid Spacing="3">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="1" Style="@BorderStyle(_summary.Balance >= 0 ? Color.Success : Color.Error)">
                <MudText Typo="Typo.overline" Color="Color.Secondary">Saldo</MudText>
                <MudText Typo="Typo.h5" Color="@(_summary.Balance >= 0 ? Color.Success : Color.Error)">
                    @Format.Currency(_summary.Balance)
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="1" Style="@BorderStyle(Color.Success)">
                <MudText Typo="Typo.overline" Color="Color.Secondary">Receitas</MudText>
                <MudText Typo="Typo.h5" Color="Color.Success">@Format.Currency(_summary.TotalIncome)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="1" Style="@BorderStyle(Color.Error)">
                <MudText Typo="Typo.overline" Color="Color.Secondary">Despesas</MudText>
                <MudText Typo="Typo.h5" Color="Color.Error">@Format.Currency(_summary.TotalExpense)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="1" Style="@BorderStyle(Color.Default)">
                <MudText Typo="Typo.overline" Color="Color.Secondary">Transações</MudText>
                <MudText Typo="Typo.h5">@_summary.TransactionCount</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Receitas x Despesas por mês</MudText>
                <MonthlyBarChart Items="_summary.Monthly" />
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="1" Style="height:100%">
                <MudText Typo="Typo.subtitle1" Class="mb-3">Gastos por categoria</MudText>
                @{
                    var withExpense = _summary.ByCategory.Where(c => c.Expense > 0).Take(8).ToList();
                }
                @if (withExpense.Count == 0)
                {
                    <MudText Color="Color.Secondary">Nenhuma despesa registrada.</MudText>
                }
                else
                {
                    var maxExpense = withExpense.Max(c => c.Expense);
                    foreach (var c in withExpense)
                    {
                        <div class="d-flex justify-space-between mb-1">
                            <MudText Typo="Typo.body2">@c.CategoryName</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@Format.Currency(c.Expense)</MudText>
                        </div>
                        <MudProgressLinear Color="Color.Primary" Rounded="true" Class="mb-3"
                                           Value="@((double)(c.Expense / maxExpense) * 100)" />
                    }
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="1" Style="height:100%">
                <div class="d-flex justify-space-between align-center mb-2">
                    <MudText Typo="Typo.subtitle1">Últimos lançamentos</MudText>
                    <MudLink Href="/transacoes" Typo="Typo.body2">ver todos</MudLink>
                </div>
                @if (_summary.RecentTransactions.Count == 0)
                {
                    <MudText Color="Color.Secondary">Nenhum lançamento ainda.</MudText>
                }
                else
                {
                    <MudList T="RecentTransactionItem" Dense="true">
                        @foreach (var t in _summary.RecentTransactions)
                        {
                            <MudListItem T="RecentTransactionItem">
                                <div class="d-flex justify-space-between align-center">
                                    <div>
                                        <MudText Typo="Typo.body2">@t.Title</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @t.CategoryName · @Format.Date(t.CreatedAt)
                                        </MudText>
                                    </div>
                                    <MudText Typo="Typo.body2"
                                             Color="@(t.Type == ETransactionType.Deposit ? Color.Success : Color.Error)"
                                             Style="font-weight:600">
                                        @(t.Type == ETransactionType.Deposit ? "+" : "-")@Format.Currency(t.Amount)
                                    </MudText>
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private DashboardSummary? _summary;
    private bool _loading = true;
    private int _monthsBack = 6;

    protected override Task OnInitializedAsync() => Load();

    private async Task OnPeriodChanged(int months)
    {
        _monthsBack = months;
        await Load();
    }

    private async Task Load()
    {
        _loading = true;
        StateHasChanged();

        var response = await Api.GetSummaryAsync(_monthsBack);
        if (response.IsSuccess && response.Data is not null)
        {
            _summary = response.Data;
        }
        else
        {
            Snackbar.Add(response.Message.Length > 0 ? response.Message : "Não foi possível carregar o dashboard.", Severity.Error);
        }

        _loading = false;
    }

    private static string BorderStyle(Color color)
    {
        var c = color switch
        {
            Color.Success => AppTheme.IncomeColor,
            Color.Error => AppTheme.ExpenseColor,
            _ => "var(--mud-palette-lines-default)"
        };
        return $"border-left:4px solid {c}";
    }
}
