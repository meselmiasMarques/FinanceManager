@page "/conta/senha"
@attribute [Authorize]
@inject AuthService Auth
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Alterar senha · FinanceManager</PageTitle>

<div class="mb-4">
    <MudText Typo="Typo.h5">Alterar senha</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary">
        Você seguirá conectado neste dispositivo; as demais sessões serão encerradas.
    </MudText>
</div>

<MudPaper Class="pa-6" Elevation="1" Style="max-width:460px">
    <EditForm Model="_model" OnValidSubmit="Submit">
        <DataAnnotationsValidator />

        <MudTextField @bind-Value="_model.CurrentPassword" Label="Senha atual" InputType="InputType.Password"
                      For="@(() => _model.CurrentPassword)" Disabled="_busy" />

        <MudTextField @bind-Value="_model.NewPassword" Label="Nova senha" Class="mt-3" InputType="InputType.Password"
                      For="@(() => _model.NewPassword)" Immediate="true" Disabled="_busy" />

        <MudTextField @bind-Value="_model.ConfirmPassword" Label="Confirmar nova senha" Class="mt-3"
                      InputType="InputType.Password" For="@(() => _model.ConfirmPassword)"
                      Immediate="true" Disabled="_busy" />

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@_error</MudAlert>
        }

        <div class="d-flex gap-2 mt-4">
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy">
                @if (_busy)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                }
                Salvar nova senha
            </MudButton>
            <MudButton Variant="Variant.Text" OnClick="@(() => Nav.NavigateTo("/"))" Disabled="_busy">Cancelar</MudButton>
        </div>
    </EditForm>
</MudPaper>

@code {
    private readonly ChangePasswordFormModel _model = new();
    private bool _busy;
    private string? _error;

    private async Task Submit()
    {
        _busy = true;
        _error = null;

        var result = await Auth.ChangePasswordAsync(_model);

        _busy = false;

        if (result.Succeeded)
        {
            Snackbar.Add("Senha alterada com sucesso.", Severity.Success);
            Nav.NavigateTo("/");
        }
        else
        {
            _error = result.Error;
        }
    }
}
